            },
            {
                id: 10,
                block: "BLOQUE II: CIUDADANÍA DIGITAL Y ÉTICA",
                proposito: "P6",
                propositoTitle: "Ciudadanía & Licenciamiento",
                question: "Una estudiante publica un manual educativo e indica que cualquiera puede reutilizarlo y adaptarlo libremente, siempre que mencione su autoría y distribuya obras derivadas bajo los mismos términos. ¿Qué licencia corresponde?",
                options: [
                    { key: "A", text: "Licencia Copyright Tradicional con Reserva de Todos los Derechos." },
                    { key: "B", text: "Licencia CC BY-SA (Atribución - CompartirIgual)." },
                    { key: "C", text: "Patente de Invención Comercial Industrial." },
                    { key: "D", text: "Marca Registrada Institucional." }
                ],
                correct: "B",
                justification: "La licencia Creative Commons CC BY-SA autoriza compartir y adaptar el contenido siempre que se dé el crédito correspondiente al autor y se mantenga la misma licencia libre en derivados."
            }
        ];

        // ----------------------------------------------------
        // STATE MANAGEMENT
        // ----------------------------------------------------
        let studentData = {
            name: '',
            group: '',
            listNumber: '',
            startTime: null,
            endTime: null
        };

        let userAnswers = {}; // { 1: 'A', 2: 'B', ... }
        let timerInterval = null;
        let totalSeconds = 45 * 60; // 45 minutes
        const LOCAL_STORAGE_KEY = 'cultura_digital_1_exam_result_v1';

        // ----------------------------------------------------
        // INITIALIZATION
        // ----------------------------------------------------
        window.addEventListener('DOMContentLoaded', () => {
            checkExistingSubmission();
            renderQuestionPills();
            renderQuestions();
        });

        function checkExistingSubmission() {
            const savedResult = localStorage.getItem(LOCAL_STORAGE_KEY);
            if (savedResult) {
                document.getElementById('already-submitted-alert').classList.remove('hidden');
                document.getElementById('btn-start-exam').classList.add('opacity-50', 'pointer-events-none');
            }
        }

        function showAlreadySubmittedResults() {
            const savedData = JSON.parse(localStorage.getItem(LOCAL_STORAGE_KEY));
            if (savedData) {
                studentData = savedData.studentData;
                userAnswers = savedData.userAnswers;
                renderResultsScreen(savedData.scoreDetails);
            }
        }

        // ----------------------------------------------------
        // UI RENDERING FUNCTIONS
        // ----------------------------------------------------
        function renderQuestionPills() {
            const container = document.getElementById('question-pills');
            container.innerHTML = EXAM_DATA.map((q, idx) => `
                <a href="#q-card-${q.id}" id="pill-${q.id}" class="w-7 h-7 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 font-bold text-xs flex items-center justify-center hover:bg-slate-700 transition">
                    ${idx + 1}
                </a>
            `).join('');
        }

        function renderQuestions() {
            const container = document.getElementById('questions-container');
            container.innerHTML = EXAM_DATA.map((q, index) => {
                return `
                <div id="q-card-${q.id}" class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 sm:p-7 space-y-4 transition duration-200 hover:border-sky-300">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center space-x-2">
                            <span class="bg-slate-900 text-white font-extrabold text-xs px-2.5 py-1 rounded-md">
                                Reactivo ${String(q.id).padStart(2, '0')}
                            </span>
                            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-sky-50 text-sky-700 border border-sky-200">
                                ${q.proposito} (${q.propositoTitle})
                            </span>
                        </div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wide">Valor: 10%</span>
                    </div>

                    <p class="text-sm sm:text-base font-semibold text-slate-900 leading-relaxed">
                        ${q.question}
                    </p>

                    <div class="space-y-2.5 pt-2">
                        ${q.options.map(opt => `
                            <label class="option-label flex items-center p-3 sm:p-3.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition group">
                                <input type="radio" name="question_${q.id}" value="${opt.key}" onchange="selectAnswer(${q.id}, '${opt.key}')" class="w-4 h-4 text-sky-600 focus:ring-sky-500 border-slate-300">
                                <span class="ml-3 font-bold text-xs sm:text-sm text-slate-600 group-hover:text-slate-900 min-w-[20px]">
                                    ${opt.key})
                                </span>
                                <span class="ml-1 text-xs sm:text-sm text-slate-700 group-hover:text-slate-900">
                                    ${opt.text}
                                </span>
                            </label>
                        `).join('')}
                    </div>
                </div>
                `;
            }).join('');
        }

        function selectAnswer(questionId, optionKey) {
            userAnswers[questionId] = optionKey;
            
            // Update Pill styling
            const pill = document.getElementById(`pill-${questionId}`);
            if (pill) {
                pill.classList.remove('bg-slate-800', 'text-slate-400', 'border-slate-700');
                pill.classList.add('bg-sky-500', 'text-white', 'border-sky-400');
            }

            // Update Progress Bar
            const totalAnswered = Object.keys(userAnswers).length;
            document.getElementById('progress-text').innerText = `${totalAnswered} de 10 contestadas`;
            const percentage = (totalAnswered / 10) * 100;
            document.getElementById('progress-bar-inner').style.width = `${percentage}%`;
        }

        // ----------------------------------------------------
        // START EXAM & TIMER LOGIC
        // ----------------------------------------------------
        function handleStartExam(e) {
            e.preventDefault();

            // Check if already completed on this browser
            if (localStorage.getItem(LOCAL_STORAGE_KEY)) {
                showAlreadySubmittedResults();
                return;
            }

            studentData.name = document.getElementById('student-name').value.trim();
            studentData.group = document.getElementById('student-group').value.trim();
            studentData.listNumber = document.getElementById('student-list').value.trim();
            studentData.startTime = new Date().toISOString();

            // Display in Exam UI
            document.getElementById('display-student-name').innerText = studentData.name;
            document.getElementById('display-student-meta').innerText = `Grupo: ${studentData.group} | N° Lista: ${studentData.listNumber}`;

            // Switch Screen
            document.getElementById('screen-registration').classList.add('hidden');
            document.getElementById('screen-exam').classList.remove('hidden');
            document.getElementById('header-timer').classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Start Timer
            startTimer();
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                totalSeconds--;
                
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                
                const formattedTime = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                document.getElementById('timer-display').innerText = formattedTime;

                if (totalSeconds <= 300) { // last 5 mins alert
                    document.getElementById('timer-display').classList.add('text-rose-400', 'animate-pulse');
                }

                if (totalSeconds <= 0) {
                    clearInterval(timerInterval);
                    submitExamNow(true); // Auto-submit when time expires
                }
            }, 1000);
        }

        // ----------------------------------------------------
        // SUBMISSION & GRADING LOGIC
        // ----------------------------------------------------
        function handlePreSubmit(e) {
            e.preventDefault();
            const totalAnswered = Object.keys(userAnswers).length;
            const msg = totalAnswered < 10 
                ? `¡Atención! Has respondido solo ${totalAnswered} de 10 preguntas. ¿Deseas entregar el examen de todas formas?`
                : `Has contestado las 10 preguntas. ¿Deseas confirmar tu envío definitivo?`;
            
            document.getElementById('modal-confirm-msg').innerText = msg;
            document.getElementById('modal-confirm-submit').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('modal-confirm-submit').classList.add('hidden');
        }

        function submitExamNow(isTimeExpired = false) {
            closeConfirmModal();
            clearInterval(timerInterval);
            studentData.endTime = new Date().toISOString();

            // Calculate Scores
            let correctCount = 0;
            let p4Score = 0; // Max 4 items (40%)
            let p5Score = 0; // Max 3 items (30%)
            let p6Score = 0; // Max 3 items (30%)

            EXAM_DATA.forEach(q => {
                const userAns = userAnswers[q.id];
                if (userAns === q.correct) {
                    correctCount++;
                    if (q.proposito === 'P4') p4Score++;
                    if (q.proposito === 'P5') p5Score++;
                    if (q.proposito === 'P6') p6Score++;
                }
            });

            const totalScorePercentage = (correctCount / 10) * 100;
            const p4Percentage = (p4Score / 4) * 40;
            const p5Percentage = (p5Score / 3) * 30;
            const p6Percentage = (p6Score / 3) * 30;

            const scoreDetails = {
                correctCount,
                totalScorePercentage,
                p4Score,
                p4Percentage,
                p5Score,
                p5Percentage,
                p6Score,
                p6Percentage,
                isTimeExpired
            };

            // Save to localStorage for single attempt enforcement
            const recordToSave = {
                studentData,
                userAnswers,
                scoreDetails,
                submittedAt: new Date().toLocaleString()
            };
            localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(recordToSave));

            // Render Results
            renderResultsScreen(scoreDetails);
        }

        function renderResultsScreen(scoreDetails) {
            document.getElementById('screen-exam').classList.add('hidden');
            document.getElementById('header-timer').classList.add('hidden');
            document.getElementById('screen-results').classList.remove('hidden');

            // Header Meta Fill
            document.getElementById('res-student-name').innerText = studentData.name || "Alumno";
            document.getElementById('res-student-group').innerText = studentData.group || "N/A";
            document.getElementById('res-student-list').innerText = studentData.listNumber || "N/A";
            document.getElementById('res-student-date').innerText = new Date().toLocaleString('es-MX');

            // Score Badges
            document.getElementById('score-percentage').innerText = `${scoreDetails.totalScorePercentage}%`;
            document.getElementById('score-points-badge').innerText = `${scoreDetails.correctCount} / 10 Aciertos`;

            // Purpose Bars
            document.getElementById('score-p4-text').innerText = `${scoreDetails.p4Percentage.toFixed(0)}% / 40%`;
            document.getElementById('bar-p4').style.width = `${(scoreDetails.p4Score / 4) * 100}%`;

            document.getElementById('score-p5-text').innerText = `${scoreDetails.p5Percentage.toFixed(0)}% / 30%`;
            document.getElementById('bar-p5').style.width = `${(scoreDetails.p5Score / 3) * 100}%`;

            document.getElementById('score-p6-text').innerText = `${scoreDetails.p6Percentage.toFixed(0)}% / 30%`;
            document.getElementById('bar-p6').style.width = `${(scoreDetails.p6Score / 3) * 100}%`;

            // Detailed Item Review List
            const listContainer = document.getElementById('results-feedback-list');
            listContainer.innerHTML = EXAM_DATA.map(q => {
                const userAns = userAnswers[q.id] || "Sin respuesta";
                const isCorrect = userAns === q.correct;

                return `
                <div class="p-5 rounded-xl border ${isCorrect ? 'bg-emerald-50/50 border-emerald-200' : 'bg-rose-50/50 border-rose-200'} space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-xs uppercase ${isCorrect ? 'text-emerald-800' : 'text-rose-800'}">
                            <i class="fa-solid ${isCorrect ? 'fa-circle-check text-emerald-600' : 'fa-circle-xmark text-rose-600'} mr-1.5"></i>
                            Reactivo ${String(q.id).padStart(2, '0')} — ${isCorrect ? 'RESPUESTA CORRECTA (+10%)' : 'RESPUESTA INCORRECTA (0%)'}
                        </span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600">
                            ${q.proposito}
                        </span>
                    </div>

                    <p class="text-xs sm:text-sm font-bold text-slate-800">${q.question}</p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <div class="p-2.5 rounded-lg ${isCorrect ? 'bg-emerald-100/70 text-emerald-900 font-semibold' : 'bg-rose-100/70 text-rose-900 font-semibold'}">
                            Tu Elección: <strong>${userAns}</strong>
                        </div>
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 text-slate-700">
                            Opción Correcta: <strong class="text-emerald-700">${q.correct}</strong>
                        </div>
                    </div>

                    <div class="bg-white p-3 rounded-lg border border-slate-200 text-xs text-slate-600">
                        <strong class="text-slate-800 block mb-0.5"><i class="fa-solid fa-lightbulb text-amber-500 mr-1"></i> Explicación Pedagógica:</strong>
                        ${q.justification}
                    </div>
                </div>
                `;
            }).join('');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ----------------------------------------------------
        // RESET MODAL LOGIC (FOR TEACHERS/DEMOS)
        // ----------------------------------------------------
        function openResetModal() {
            document.getElementById('modal-reset').classList.remove('hidden');
        }

        function closeResetModal() {
            document.getElementById('modal-reset').classList.add('hidden');
        }

        function confirmResetLocalStorage() {
            localStorage.removeItem(LOCAL_STORAGE_KEY);
            closeResetModal();
            window.location.reload();
        }
    </script>
</body>
</html>

