            },
            {
                id: 6,
                block: "BLOQUE II: CIUDADANÍA DIGITAL Y ÉTICA",
                proposito: "P6",
                propositoTitle: "Ciudadanía & Licenciamiento",
                question: "Un dispositivo móvil en buen estado físico deja de recibir actualizaciones de software, impidiendo instalar aplicaciones indispensables. ¿Qué concepto describe esta problemática y qué acción ciudadana sostenible corresponde?",
                options: [
                    { key: "A", text: "Brecha digital de acceso; desechar el equipo en un vertedero." },
